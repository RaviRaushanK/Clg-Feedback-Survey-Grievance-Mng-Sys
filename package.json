{
  "name": "campusvoice",
  "version": "1.0.0",
  "description": "College Feedback, Survey and Grievance Management System",
  "main": "server.js",
  "scripts": {
    "dev:backend": "node --watch server.js",
    "dev:frontend": "vite frontend --host 0.0.0.0 --port 5173",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node server.js",
    "build:frontend": "vite build frontend --outDir dist",
    "preview:frontend": "vite preview frontend --port 4173",
    "check:backend": "node --check app.js && node --check server.js && node --check config/env.js && node --check config/db.js"
  },
  "keywords": [
    "mern",
    "college",
    "feedback",
    "survey",
    "grievance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "mongoose": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.3"
  }
}
